            echo -e "${YELLOW}⚠ Найдено незавершенное состояние операции${NC}"
            echo "1) Продолжить операцию"
            echo "2) Показать статус"
            echo "3) Справка"
            echo "4) Выход"
        else
            echo "Доступные действия:"

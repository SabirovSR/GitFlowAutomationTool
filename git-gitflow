                deliver_changes "test"
            else
                # Создание hotfix
                read -p "Тип hotfix (pe/oe/iz): " hf_type
                read -p "Номер JIRA: " hf_jira
                read -p "Коммит для cherry-pick (Enter для пропуска): " hf_commit
                create_hotfix "$hf_type" "$hf_jira" "$hf_commit"
            fi
            ;;
        2)
            if [[ -f "$STATE_FILE" ]] || ! parse_current_branch; then
                show_status
            else
                deliver_changes "release_oe"
            fi
            ;;
        3)
            if [[ -f "$STATE_FILE" ]] || ! parse_current_branch; then
                show_help
            else
                deliver_changes "release_pe"
            fi
            ;;
        4)
            if [[ -f "$STATE_FILE" ]]; then
                exit 0
            elif parse_current_branch; then
                update_pr "test"
            else
                exit 0
            fi
            ;;
        5)
            if parse_current_branch; then
                update_pr "release_oe"
            fi
            ;;
        6)
            if parse_current_branch; then
                update_pr "release_pe"
            fi
            ;;
        7)
            if parse_current_branch; then
                read -p "Тип hotfix (pe/oe/iz): " hf_type
                read -p "Номер JIRA: " hf_jira
                read -p "Коммит для cherry-pick (Enter для пропуска): " hf_commit
                create_hotfix "$hf_type" "$hf_jira" "$hf_commit"
            fi
            ;;
        8)
            if parse_current_branch; then
                show_status
            fi
            ;;
        9)
            if parse_current_branch; then
                show_help
            fi
            ;;
        0)
            exit 0
            ;;
        *)
            error "Неверный выбор"
            ;;
    esac
}

# Основная функция
main() {
    check_git_repo
    
    case "${1:-}" in
        "deliver")
            deliver_changes "${2:-test}"
            ;;
        "update")
            update_pr "${2:-test}"
            ;;
        "hotfix")
            create_hotfix "$2" "$3" "$4"
            ;;
        "continue")
            continue_operation
            ;;
        "status")
            show_status
            ;;
        "help"|"--help"|"-h")
            show_help
            ;;
        "")
            show_menu
            ;;
        *)
            error "Неизвестная команда: $1"
            echo "Используйте 'git gitflow help' для справки"
            exit 1
            ;;
    esac
}

# Запуск основной функции
main "$@"
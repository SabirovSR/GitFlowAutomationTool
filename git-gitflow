            echo ""
            echo "1) Показать статус"
            echo "2) Справка"
            echo "3) Выход"
        else
            warning "Текущая ветка не соответствует GitFlow конвенциям"
            echo "Доступные действия:"
            echo ""
            echo "1) Создать hotfix"
            echo "2) Показать статус"
            echo "3) Справка"
            echo "4) Выход"
        fi
    else
        echo "Текущая ветка: $CURRENT_BRANCH"
        echo ""
        
